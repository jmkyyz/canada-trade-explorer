{
  "name": "Decoder prototype (neutral placeholder)",
  "notes": "Placeholder styling. The video team swaps this whole folder for Globe branding: colours, fonts, sizes, layout and caption style all live here. Optional files beside it: theme.css (injected into the chart page, e.g. @font-face rules) and fonts/ (also handed to libass for burned-in captions).",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#101010"
  },
  "layout": {
    "chart": {
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 1152
    },
    "talent": {
      "x": 0,
      "y": 1152,
      "width": 1080,
      "height": 768,
      "default_crop_center": 0.42
    }
  },
  "fonts": {
    "headline": "\"Helvetica Neue\", Helvetica, Inter, Arial, sans-serif",
    "body": "\"Helvetica Neue\", Helvetica, Inter, Arial, sans-serif",
    "numeric": "\"Helvetica Neue\", Helvetica, Inter, Arial, sans-serif"
  },
  "chart": {
    "background": "#fcfcfb",
    "padding": {
      "top": 64,
      "right": 64,
      "bottom": 48,
      "left": 64
    },
    "plot_margin": {
      "top": 40,
      "right": 210,
      "bottom": 80,
      "left": 120
    },
    "title": {
      "size": 58,
      "weight": 700,
      "color": "#0b0b0b",
      "line_height": 1.12
    },
    "subtitle": {
      "size": 36,
